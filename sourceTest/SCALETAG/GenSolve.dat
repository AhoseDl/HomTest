    PetscErrorCode pbcTaoDispForce2(MeshPbc<T,D>& Mh, size_t ndof, BCs& bc, std::vector<pbcEquation>& pbcLinks,
                                   T (*matrixValue)(const MeshPbc<T,D>& Mh,size_t e,size_t ie, size_t je, size_t kie, size_t kje),
                                   int solType, std::valarray<T>& disp, std::valarray<T>& force
                                   ){

//std::vector<pbcEquation> pbcLinks;

matrix<T> KG;
matrix<T> constrMat;
std::valarray<double> constrVec, vecC;

size_t nNotDir;
std::valarray<size_t> numPbc;
std::valarray<bool> meshAndNDir;
std::valarray<bool> meshAndDir;
std::valarray<bool> NMeshAndDir;
std::valarray<bool> NMeshAndNDir;
size_t NbLinks; vector<size_t> sommets; std::vector<size_t> notMeshNodes;

scaletag::models::PbcUtilities pbc;

std::valarray<double> dispNumPbc, forceNumPbc, lambda;
models::DataForPetsc petscData;

PetscFunctionBeginUser;

//pbcLinks.clear();
pbc.createPbcLinks(Mh,pbcLinks, NbLinks, sommets, notMeshNodes); //natural numerotation
bc.setSommets(sommets); //natural numerotation
bc.setNotMeshNodes(notMeshNodes, ndof);

//Setting boundary conditions
//0->Tx, 1->Ty, 2->Tz, 3->CisXY, 4->cisXZ, 5->cisYZ
if(solType==0) bc.setTractionX(3); if(solType==1) bc.setTractionY(3); if(solType==2) bc.setTractionZ(3);
if(solType==3) bc.setCisXY(3); if(solType==4) bc.setCisXZ(3); if(solType==5) bc.setCisYZ(3);

bc.setPbc(pbcLinks, ndof, sommets);  //Fill tiedDofs and retainedDofs in bc
renumberingPbc2(Mh, numPbc,  ndof, bc, meshAndNDir, meshAndDir, NMeshAndDir, NMeshAndNDir);
size_t nm, nm1, nm2, nr, nr1, nr2;

nm1 = std::count(std::begin(meshAndNDir), std::end(meshAndNDir), true);
nm2 = std::count(std::begin(meshAndDir), std::end(meshAndDir), true);
nm = nm1+nm2;

nr1 = std::count(std::begin(NMeshAndDir), std::end(NMeshAndDir), true);
nr2 = std::count( std::begin(NMeshAndNDir), std::end(NMeshAndNDir), true);
nr = nr1+nr2;

bc.setRefCount(nm1, nm2, nr1, nr2);
//size_t mbar, md, rd, rdbar; //mesh and not dir, mesh and dir, ref and dir, ref and not Dir

int ws, wr;
MPI_Comm_size(MPI_COMM_WORLD, &ws);
MPI_Comm_rank(MPI_COMM_WORLD, &wr);

fem::globFemAssembly(Mh, numPbc, KG, ndof, bc, matrixValue); // Galerkin matrix. Dirichlet components are included
pbc.createPbcConstraintsMatrix(Mh, pbcLinks, numPbc, bc, ndof, constrMat);  //G
pbc.createPbcConstraintsVector(Mh, pbcLinks, numPbc, bc, ndof, constrVec); //S

dispNumPbc.resize(ndof*Mh.getNumberOfNodes(), 0.);
forceNumPbc.resize(ndof*Mh.getNumberOfNodes(), 0.);


MPI_Barrier(MPI_COMM_WORLD);

PetscCall(petscData.petscSolveLinearRedMumpsCond2(Mh, ndof, KG, constrMat, constrVec,     numPbc, bc, dispNumPbc, lambda));

MPI_Barrier(MPI_COMM_WORLD);
if(wr==0){
std::vector<size_t> dirdofs = bc.getDirichletDofs();
size_t nd = dirdofs.size();

matrix<double> GBar = constrMat ; GBar.nFirstLines(constrMat.nrow() -nd);
//GBar=constrMat; // To be deleted

matrix<double> Gm =GBar; Gm.nFirstColumns(nm);
matrix<double> Gr = GBar; Gr.nLastColumns(nr);

std::valarray<double> um = dispNumPbc[(meshAndNDir||meshAndDir)];
//forceNumPbc[(meshAndNDir||meshAndDir)] += KG*um + (Gm.transpose())*lambda;
//forceNumPbc[(NMeshAndDir||NMeshAndNDir)] += (Gr.transpose())*lambda;
forceNumPbc = 0. ;
forceNumPbc[(meshAndNDir||meshAndDir)] += KG*um ;//+ (Gm.transpose())*lambda;
forceNumPbc/*[(NMeshAndDir||NMeshAndNDir)]*/ += (GBar.transpose())*lambda;

disp.resize( nm+nr, 0.0 );
force.resize( nm+nr, 0.0 );

disp[meshAndNDir] = dispNumPbc[std::slice(0, nm1, 1)];
disp[meshAndDir] = dispNumPbc[std::slice(nm1, nm2, 1)];
disp[NMeshAndDir] = dispNumPbc[std::slice(nm, nr1, 1)];
disp[NMeshAndNDir] = dispNumPbc[std::slice(nm+nr1, nr2, 1)];

force[meshAndNDir] = forceNumPbc[std::slice(0, nm1, 1)];
force[meshAndDir] = forceNumPbc[std::slice(nm1, nm2, 1)];
force[NMeshAndDir] = forceNumPbc[std::slice(nm, nr1, 1)];
force[NMeshAndNDir] = forceNumPbc[std::slice(nm+nr1, nr2, 1)];

}

PetscFunctionReturn(PETSC_SUCCESS);
    }




































PetscErrorCode DataForPetsc::petscSolveLinearRedMumpsCond2(const MeshPbc<double,3>& Mh, size_t ndof, const fem::matrix<double>& _KG,
        const fem::matrix<double>& constrMat, const std::valarray<double>& constrVec , const std::valarray<size_t>& numPbc , const fem::BCs& bc,
                                                          std::valarray<double>& sol, std::valarray<double>& lambda){

    //fem::matrix<double> Kuu, Kud, Gu, Gd;
    std::valarray<double> fu, fl, ud;
    std::vector<size_t> dirdofs;
    fem::matrix<double> Kuu, Gu, Gr; //For reduced system
    //matrix<double> GBar;
    fem::matrix<double> constrMatBar; //To erase the hardcoded dirichlet dofs
    dirdofs=bc.getDirichletDofs();
    size_t nd=dirdofs.size();
    constrMatBar=constrMat; constrMatBar.nFirstLines(constrMat.nrow()-nd); //To ignore the hardcoded dirichlet boundary conditions
    //constrMatBar=constrMat; //To be deleted
    std::valarray<double> ulambda;              //for ubar&lambda
    std::valarray<double> dispPbc;                //(size_t(nu+nd), 0.); //for u

    size_t meshAndNDir, meshAndDir, NMeshAndDir, NMeshAndNDir;
    bc.getRefCount(meshAndNDir, meshAndDir, NMeshAndDir, NMeshAndNDir);
    Kuu = _KG; Kuu.nFirstLines(meshAndNDir); Kuu.nFirstColumns(meshAndNDir);
    Gu = constrMatBar; Gu.nFirstColumns(meshAndNDir);
    Gr = constrMatBar; Gr.nLastColumns(NMeshAndNDir);

    std::valarray<double> FRed;
    fem::matrix<double> GRed; fem::matrix<double> O12, O21, O22, O33;
    O12.zero(meshAndNDir, NMeshAndNDir);
    O21.zero(NMeshAndNDir, meshAndNDir);
    O22.zero(NMeshAndNDir, NMeshAndNDir);
    O33.zero(constrMatBar.nrow(), constrMatBar.nrow());
    std::valarray<double> udd; //udd for mesh and dir
    std::valarray<double> urd;
    udd.resize(meshAndDir, 0.);
    urd.resize(NMeshAndDir, 0.);

    for(size_t i=0; i<ndof*Mh.getNumberOfNodes(); i++){
    if( bc.isMeshDof(i) && bc.isDirichlet((i)) )
            udd[numPbc[i] -meshAndNDir] = bc.pbcDirichletValue(i, ndof);
    if( !bc.isMeshDof(i) && bc.isDirichlet((i)) )
            urd[numPbc[i] -meshAndNDir-meshAndDir] = bc.pbcDirichletValue(i, ndof);
    }
    GRed=Gu;
    if(NMeshAndNDir!=0){
    Kuu.appendMatrixToRight(O12);
    fem::matrix<double> O2 =  O21; O2.appendMatrixToRight(O22);
    Kuu.appendMatrixToBottom(O2);
    GRed.appendMatrixToRight(Gr);
    //fem::matrix<double> GRedB = Gu; GRedB.appendMatrixToRight(Gr);
    //GRed.appendMatrixToBottom(GRedB);
    FRed.resize( meshAndNDir+NMeshAndNDir+constrMatBar.nrow(), 0. );
    if(udd.size() !=0 ){
            fem::matrix<double> Gd = constrMatBar; Gd.nFirstColumns(meshAndDir+meshAndNDir);
            Gd.nLastColumns(meshAndDir);
            fem::matrix<double> Kd= _KG; Kd.nLastColumns(meshAndDir);
            FRed[std::slice(0, meshAndNDir+meshAndDir,1)] = -1*(Kd*udd);
            FRed[std::slice(meshAndDir+meshAndNDir, constrMatBar.nrow(), 1)] -= Gd*udd;}

    //Analyzing -1*Gd.ud-1*Grd.urd

    fem::matrix<double> Grd = constrMatBar;
    Grd.nLastColumns(NMeshAndDir+NMeshAndNDir);
    Grd.nFirstColumns(NMeshAndDir);
    FRed[std::slice(meshAndDir+meshAndNDir, constrMatBar.nrow(), 1)] -= (Grd*urd);
//    if(udd.size()!=0)
//            FRed[std::slice(meshAndDir+meshAndNDir, constrMatBar.nrow(), 1)] -= Gd*udd;
    }
    //Building the overall system
    fem::matrix<double> GRedT = GRed.transpose();

    fem::matrix<double> Ap = Kuu;
    fem::matrix<double> Gup = GRed;
    fem::matrix<double> GupT = Gup.transpose();
    Ap.appendMatrixToRight(GupT);
    fem::matrix<double> Ap1 = GRed; Ap1.appendMatrixToRight(O33);
    Ap.appendMatrixToBottom(Ap1);

    std::valarray<double> rhsp = FRed;

    //Begin Conditioning
    //End Conditioning

    MPI_Barrier(MPI_COMM_WORLD);


    Mat Af; Vec solf, rhsf; PetscInt rb, re; PetscErrorCode ierr;
    KSP ksp; PC pc;

    std::valarray<double> cstrVec, uForce, rhsplat; //std::valarray<double> rhsp;

    PetscFunctionBeginUser;

    MPI_Barrier(MPI_COMM_WORLD);

    PetscInt nLamb = constrMatBar.nrow();
    matrixToPetscMat(Ap, Af);
    for(PetscInt i=0; i<nLamb; i++)
    MatSetValue(Af, PetscInt(meshAndNDir+meshAndDir+i), PetscInt(meshAndNDir+meshAndDir+i), 0., INSERT_VALUES);

    MatAssemblyBegin(Af, MAT_FINAL_ASSEMBLY);
    MatAssemblyEnd(Af, MAT_FINAL_ASSEMBLY);

//    PetscViewer viewer;
//    PetscViewerBinaryOpen(PETSC_COMM_WORLD, "/home/ahose/venus/petscAf.dat", FILE_MODE_WRITE, &viewer);
//    MatView(Af, viewer);

PetscBarrier(PetscObject(Af));
    MatCreateVecs(Af, &solf, &rhsf);
    PetscScalar* rhsArray;
    VecGetOwnershipRange(rhsf, &rb, &re);
    VecGetArray(rhsf, &rhsArray);
    for(PetscInt i=rb; i<re; i++) rhsArray[i-rb]=rhsp[i];
    VecRestoreArray(rhsf, &rhsArray);

    //MatShift(Af, 1e-20);
PetscBarrier(PetscObject(Af));

    KSPCreate(PETSC_COMM_WORLD, &ksp);
    KSPSetOperators(ksp,Af, Af);
    //KSPSetType(ksp, KSPPREONLY);
    //KSPGetPC(ksp,&pc);
    //PCSetType(pc, PCLU);
    //PCFactorSetMatSolverType(pc, MATSOLVERMUMPS);
   // KSPGetPC(ksp, &pc);
    //PCSetType(pc, PCLU);
//    PCFactorSetMatSolverType(pc, MATSOLVERMUMPS);
//    PCSetFromOptions(pc);
//    KSPSetFromOptions(ksp);

    //KSPGetPC(ksp, &pc);
    //KSPSetType(ksp, KSPFGMRES);
    //PCSetType(pc, PCFIELDSPLIT);

//    PetscInt sizeU=(PetscInt)Kuu.nrow();
//    PetscInt sizeL=(PetscInt)Gu.nrow();

//    IS is_u, is_L;
//    ierr = ISCreateStride(PETSC_COMM_WORLD, sizeU, 0, 1, &is_u); CHKERRQ(ierr);
//    ierr = ISCreateStride(PETSC_COMM_WORLD, sizeL, sizeU, 1, &is_L); CHKERRQ(ierr);

//    ierr = PCFieldSplitSetIS(pc, "champ_0", is_u); CHKERRQ(ierr);
//    ierr = PCFieldSplitSetIS(pc, "champ_1", is_L); CHKERRQ(ierr);

//    ierr = PCFieldSplitSetType(pc, PC_COMPOSITE_SCHUR); CHKERRQ(ierr);
//    ierr = PCFieldSplitSetSchurFactType(pc, PC_FIELDSPLIT_SCHUR_FACT_FULL); CHKERRQ(ierr);

//    ierr = ISDestroy(&is_u); CHKERRQ(ierr);
//    ierr = ISDestroy(&is_L); CHKERRQ(ierr);

    // 6. Autoriser le contrôle via les options utilisateur
    ierr = KSPSetFromOptions(ksp); CHKERRQ(ierr);

    PetscInt Ar, Ac, rhssize, solsize;
    MatGetSize(Af, &Ar, &Ac);
    VecGetSize(rhsf, &rhssize);
    VecGetSize(solf, &solsize);
    std::cout<<"Af size : "<<Ar<<" x "<<Ac<<std::endl;
    std::cout<<"rsh2 size :  "<<rhssize<<std::endl;
    std::cout<<"sol2 size : "<<solsize<<std::endl;

{//    Mat petscKuu;
//    matrixToPetscMat(Kuu, petscKuu);
//    // MatShift(petscKuu, 1e-6*608.*5.*5e-7);
//    PetscScalar hh=solveEigen(petscKuu, EPS_LARGEST_REAL);
//    PetscScalar ll=solveEigen(petscKuu, EPS_SMALLEST_REAL);
//    std::cout<< "Af higher proper value : "<<hh<<std::endl;
//    std::cout<< "Af smallest proper value : "<<ll<<std::endl;


//    Vec DInv;
//    MatCreateVecs(petscKuu, NULL, &DInv);
//    MatGetDiagonal(petscKuu, DInv);
//    VecPow(DInv, -0.5);
//    MatDiagonalScale(petscKuu, DInv, DInv);
//    hh=solveEigen(petscKuu, EPS_LARGEST_REAL);
//    ll=solveEigen(petscKuu, EPS_SMALLEST_REAL);
//    std::cout<< "Af higher proper value  after conditioning: "<<hh<<std::endl;
//    std::cout<< "Af smallest proper value after conditioning: "<<ll<<std::endl;
//    size_t ne=Mh.getNumberOfElements()*4*3;
//    std::cout<< "Numbers of dofs based on number of elements "<<ne<<std::endl;
//    MPI_Barrier(MPI_COMM_WORLD);
}

    MPI_Barrier(MPI_COMM_WORLD);
    KSPSetTolerances(ksp,0., 1.e-12, PETSC_UNLIMITED, PETSC_UNLIMITED);
    KSPSetFromOptions(ksp);
    std::cout<<" Solving Af.solf=rhsf ... "<<std::endl;

    PetscBarrier(PetscObject(Af));
    //VecSet(sol2, 1.0);
    ierr = KSPSolve(ksp, rhsf, solf); CHKERRQ(ierr);
    KSPSetFromOptions(ksp);
    PetscBarrier(PetscObject(Af));

    std::cout<<"End solving Af.solf=rhsf "<<std::endl;
    KSPConvergedReason kspreason;
    KSPGetConvergedReason(ksp, &kspreason);
    if(kspreason<0) std::cout<<"Diverged with reason : "<<kspreason<<std::endl;
    else std::cout<<"Converged with reason : "<<kspreason<<std::endl;

    if (kspreason == KSP_DIVERGED_PC_FAILED) {
    PC pc;
    PCFailedReason pc_reason;
    KSPGetPC(ksp, &pc);
    PCGetFailedReason(pc, &pc_reason);
    // Imprime le code d'erreur spécifique du PC (ex: voir la liste des PCFailedReason)
    PetscPrintf(PETSC_COMM_WORLD, "Le PC a échoué avec le code : %d\n", pc_reason);
}
    //    //****************** Recovering the real U ***************************
    MPI_Barrier(MPI_COMM_WORLD);

    VecToValarray(solf, ulambda);

    //dispPbc[std::slice(0, nu, 1)] = ulambda[std::slice(0, nu, 1)];
    dispPbc.resize(meshAndNDir+meshAndDir+NMeshAndDir+NMeshAndNDir, 0.);

    std::valarray<double> solubar = ulambda[std::slice(0, meshAndNDir, 1)] ;
    dispPbc[std::slice(0, meshAndNDir, 1)] = solubar ; //*DPowerMinusHalf;
    std::valarray<double> solRBar = ulambda[std::slice(meshAndNDir, NMeshAndNDir, 1)] ;
    dispPbc[std::slice(meshAndNDir, NMeshAndNDir, 1)] = solRBar ;
    lambda.resize(nLamb, 0.);
    lambda = ulambda[std::slice(meshAndNDir+NMeshAndNDir, nLamb, 1)] ;
    //lambda = etaPowerMinuxOne*lambda;
    std::ofstream ofs("/home/ahose/Desktop/lambda.dat");
    for(size_t i=0; i<lambda.size(); i++) ofs<<lambda[i]<<std::endl;
    ofs.close();

    for(size_t i=0; i<(nd); i++) dispPbc[ numPbc[dirdofs[i]] ]=bc.pbcDirichletValue( dirdofs[i], ndof );
    sol=dispPbc;

    //dataForPetsc.VecToValarray(U, sol);
    PetscFunctionReturn(PETSC_SUCCESS);
}


