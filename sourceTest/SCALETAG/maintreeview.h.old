class TreeItem{
private:
    QString name;
    QString decoration;
    TreeItem* parentItem;
    QList<TreeItem*> childItems;
    void appendChildItem(TreeItem* _treeItem){}
    TreeItem(const QString& _name, const QString& _decoration, TreeItem* _parentItem=nullptr){
        name=_name; decoration=_decoration; parentItem=_parentItem;
    }
};



class ScaleTagTreeModel : public /*QStandardItemModel*/QAbstractItemModel{
    Q_OBJECT

public:
    explicit ScaleTagTreeModel(scaletag::frames::Project* _project) : QAbstractItemModel(_project), project(_project){
        //initProjectTreeModel();
    }

    Qt::ItemFlags flags(const QModelIndex &index) const override
    {
        if (!index.isValid())
            return Qt::NoItemFlags;

//        return Qt::ItemIsEditable | QAbstractItemModel::flags(index);
        return QAbstractItemModel::flags(index);

    }


    QVariant data(const QModelIndex &index, int role=Qt::DisplayRole) const override {
        if(index.row()==0 && index.column()==0 && role==Qt::DisplayRole && index.parent()==QModelIndex()) return QVariant("Models");
        if(index.row()==1 && index.column()==0 && role==Qt::DisplayRole && index.parent()==QModelIndex()) return QVariant("Analysis");
        if(index.row()==2 && index.column()==0 && role==Qt::DisplayRole && index.parent()==QModelIndex()) return QVariant("Materials");
        if(index==QModelIndex() ) return QVariant();
        return QVariant();
    }

   // bool setData(const QModelIndex &index, const QVariant &value, int role = Qt::EditRole) override{}


    int rowCount(const QModelIndex& index) const override{
        //if (!index.isValid()) return 1;
        if (index.parent()==QModelIndex()) return 3;
    }
    int columnCount(const QModelIndex& index) const   override{
        //if (index.isValid()) return 1;
        return 1;
     }
QVariant qeaderData(int section, Qt::Orientation orientation, int role = Qt::DisplayRole) const override{return QVariant();}


    QModelIndex index(int row, int column,const QModelIndex &parent = {}) const override{
        //if(!parent.isValid()) return QModelIndex();
        //if (!hasIndex(row, column, parent))

        if((row==0 && column==0 && parent==QModelIndex())
        || (row==1 && column==0 && parent==QModelIndex())
        || (row==2 && column==0 && parent==QModelIndex()))
        return createIndex(row, column, nullptr);

        return QModelIndex();
    }


QModelIndex parent(const QModelIndex &index) const override{
        if(index.isValid()) return QModelIndex();
        return QModelIndex();
}

    void initProjectTreeModel(){
        //QModelIndex rootIndex=createIndex(0,0, nullptr);
//        QModelIndex rootIndex=createIndex(0,0, nullptr);
      //QModelIndex rootIndex= index(0,0,createIndex(0,0, project));
        //index(0,0, QModelIndex());

//      index(0,0,rootIndex);
//       index(1,0,rootIndex);
//       index(2,0,rootIndex);

             index(0,0,QModelIndex());
               index(1,0,QModelIndex());
               index(2,0,QModelIndex());


    }


private:
scaletag::frames::Project* project;
std::unique_ptr<TreeItem> rootItem;
};




class ScaleTagTreeView : public QTreeView{

private:
QScopedPointer<ScaleTagTreeModel> treeModel;
   //scaletag::window::MainWindow* mainWindow;
   // scaletag::frames::Project* project;



public:

    ScaleTagTreeView(scaletag::frames::Project* _project): QTreeView(){
        treeModel.reset(new ScaleTagTreeModel(_project));
       this->setRootIndex(QModelIndex());
        treeModel->initProjectTreeModel();
       QString treeStyleSheet{"QTreeView::branch:open:has-children{border-image: url(:/icons/borderexpand) 0;}"
                               "QTreeView::branch:closed:has-children{border-image: url(:/icons/bordercollapse) 0;}"
                               "QTreeView::branch:has-siblings:!adjoins-item{border-image:url(:/icons/borderline) 0;}"
                               "QTreeView::branch:has-siblings:adjoins-item{border-image:url(:/icons/bordermore) 0;}"
                               "QTreeView::branch:!has-children:!has-siblings:adjoins-item{border-image:url(:/icons/borderend) 0;}"
                               "QTreeView::branch:closed:has-children:!has-siblings{border-image: url(:/icons/bordercollapse) 0;}"
                               "QTreeView::branch:closed:has-children:has-siblings{border-image: url(:/icons/bordercollapsemore) 0;}"
                               "TreeView::branch:open:has-children:!has-siblings{border-image: url(:/icons/borderexpand) 0;}"
                               "QTreeView::branch:open:has-children:has-siblings{border-image: url(:/icons/borderexpandmore) 0;}"};
       this->setStyleSheet(treeStyleSheet);
    }



