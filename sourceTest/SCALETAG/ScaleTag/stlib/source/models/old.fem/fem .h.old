//*********************************unique_insert
template <typename T>
void unique_insert (std::list<T>& L, const T& j) {
 typename std::list<T>::iterator iter = L.begin(), last = L.end();
 while (iter != last && *iter < j) ++iter;
 if (iter == last || *iter != j) L.insert(iter, j);
}


//*********************************renumbering
template<typename T, size_t D>
void renumbering(const MeshPbc<T,D>& Mh, std::valarray<size_t>& num, size_t& _iNotDir, size_t ndof,const BCs& bc){
    //bool(*_isDirichlet)(const BCs& bc, size_t _dof) = [](const BCs&, size_t){return false;}

// num is the total number of dofs
//ndof is the degree of freedom per node
  num.resize(ndof*Mh.getNumberOfNodes());
  size_t iDir= 0, iNotDir = 0;
  for (size_t i = 0; i < ndof*Mh.getNumberOfNodes(); i++)
      if (bc.isDirichlet(i))
      num[i] = iDir++;
    else
      num[i] = iNotDir++;
      
_iNotDir=iNotDir; //_iNotDir is the number of dofs where dirichlet BCs are not applied
}


//*********************************renumbering

bool findValue(std::valarray<size_t>& vec, size_t i){
auto resIt=std::find(std::begin(vec), std::end(vec), i);
if(resIt==std::end(vec)) return false; else return true;
}

template<typename T, size_t D>
void renumberingPbc(const MeshPbc<T,D>& Mh, std::valarray<size_t>& numPbc, size_t& _iNotDir, size_t ndof, BCs& bc,
std::valarray<bool>& masqDir, std::valarray<bool>& masqTied, std::valarray<bool>& masqRet,
std::valarray<bool>& masqNotConstrained){
//numPbc is the total number of dofs
//ndof is the degree of freedom per node
//bc.setPbc();
numPbc.resize(ndof*Mh.getNumberOfNodes(),0);
masqDir.resize(ndof*Mh.getNumberOfNodes(),0);
masqTied.resize(ndof*Mh.getNumberOfNodes(),0);
masqRet.resize(ndof*Mh.getNumberOfNodes(),0);
masqNotConstrained.resize(ndof*Mh.getNumberOfNodes(),0);

size_t iDir = 0, iRet = 0, iTied=0, iNotCstr=0; size_t ik=0;
size_t nnode=Mh.getNumberOfNodes();

for (size_t kndof = 0; kndof < ndof; kndof++){
    for(size_t knode=0; knode<nnode; knode++){
    ik=ndof*knode+kndof;

    if (bc.isDirichlet(ik) /*&& !bc.isRetained(ik) && !bc.isTied(ik)*/){numPbc[ik] = iDir++; masqDir[ik]=1; continue;}
    //else
    if (bc.isRetained(ik) /*&& !bc.isDirichlet(ik) && !bc.isTied(ik)*/) {numPbc[ik] = iRet++;masqRet[ik]=1; continue;}
    //else
    if (bc.isTied(ik) /*&& !bc.isDirichlet(ik) && !bc.isRetained(ik)*/){numPbc[ik] = iTied++; masqTied[ik]=1; continue;}
    //if( !bc.isDirichlet(ik) && !bc.isTied(ik) && !bc.isRetained(ik))
    {numPbc[ik] = iNotCstr++; masqNotConstrained[ik]=1;}
}}

numPbc[masqRet]=std::valarray<size_t>(numPbc[masqRet])+iNotCstr;
numPbc[masqTied]=std::valarray<size_t>(numPbc[masqTied])+iNotCstr+iRet;
numPbc[masqDir]=std::valarray<size_t>(numPbc[masqDir])+iNotCstr+iRet+iTied;
_iNotDir=ndof*Mh.getNumberOfNodes()-iDir; //_iNotDir is the number of dofs where dirichlet BCs are not applied

std::valarray<size_t> num(ndof*Mh.getNumberOfNodes());
for(size_t p=0; p<ndof*Mh.getNumberOfNodes(); p++) num[p]=p;
std::valarray<size_t> valTiedTemp=std::valarray<size_t>(num[masqTied]);
std::valarray<size_t> valRetTemp=std::valarray<size_t>(num[masqRet]);
std::vector<size_t>retDofs(std::begin(valRetTemp),std::end(valRetTemp));
std::vector<size_t> tiedDofs(std::begin(valTiedTemp),std::end(valTiedTemp));
bc.actualizePbc(tiedDofs, retDofs);

bc.setRenumRetNumber(std::valarray(masqRet[masqRet]).size());
bc.setRenumTiedNumber(std::valarray(masqTied[masqTied]).size());

}
template<typename T, size_t D>
void renumberingPbcRel(const MeshPbc<T,D>& Mh, std::valarray<size_t>& numPbc, size_t& _iNotDir, size_t ndof, BCs& bc,
                    std::valarray<bool>& masqDir, std::valarray<bool>& masqTied, std::valarray<bool>& masqRet,
                    std::valarray<bool>& masqNotConstrained){

numPbc.resize(ndof*Mh.getNumberOfNodes(),0);
masqDir.resize(ndof*Mh.getNumberOfNodes(),0);
masqTied.resize(ndof*Mh.getNumberOfNodes(),0);
masqRet.resize(ndof*Mh.getNumberOfNodes(),0);
masqNotConstrained.resize(ndof*Mh.getNumberOfNodes(),0);

size_t iDir = 0, iRet = 0, iTied=0, iNotCstr=0; size_t ik=0;/*id=0, ir=0; it=0;*/
size_t nnode=Mh.getNumberOfNodes();
for(size_t knode=0; knode<nnode; knode++){
for (size_t kndof = 0; kndof < ndof; kndof++){
    ik=ndof*knode+kndof;
    if (bc.isDirichlet(ik))
    {numPbc[ik] = iDir++; masqDir[ik]=1; /*continue;*/}
    /*else */if (bc.isTied(ik))
    {numPbc[ik] = iTied++; masqTied[ik]=1; /*continue;*/}
    /*else */if (bc.isRetained(ik))
    {numPbc[ik] = iRet++;masqRet[ik]=1; /*continue;*/}
    /*else*/ {numPbc[ik] = iNotCstr++; masqNotConstrained[ik]=1;}
}
}
}



//*********************************PASS1

template <typename T, size_t D>
void dimensionMatrix(const MeshPbc<T,D>& Mh, const std::valarray<size_t>& num, matrix<T>& a, size_t ndof,const BCs& bc,
                     std::vector<std::list<size_t> >& s
   // bool(*_isDirichlet)(const BCs& bc,size_t _dof) = [](size_t){return false;})
                     )
{
  //size_t n = Th.n_internal_vertex();
  //size_t ndof;
  size_t n=ndof*Mh.getNumberOfNodes()-bc.getDirNumber();  // dof number where dirichlet is not applied
  //renumbering(Th,num,n, ndof,bc); // This to take into account dirichlet boundary condition
  //renumberingPbc(Th, num, n, ndof, bc, masqDir, masqTied, masqRet, masqNotConstrained);
  //std::vector<std::list<size_t> >
  s.resize(n);
  for (size_t e = 0; e < Mh.getNumberOfElements(); e++){
  size_t nv=Mh.getElements()[e].getElementSize();
  //for (size_t k = 0; k < ndof; k++){
  
    for (size_t ie = 0; ie < nv; ie++){
       for (size_t je = 0; je < nv; je++) {
            for (size_t kie = 0; kie < ndof; kie++){
                size_t i = ndof*(Mh.getElements()[e].getConnectivity()[ie] -1)+kie;
                if (bc.isDirichlet( i)) continue;
                unique_insert(s[num[i]], num[i]);

            for (size_t kje = 0; kje < ndof; kje++){
                size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
                if (j == i || bc.isDirichlet(j)) continue;
                unique_insert (s[num[i]], num[j]);
            }}
        //i,j are degree of freedom numbers
      }

    }//End k
    }
  a.resize (s, n);
}

//*********************************PASS2

//#include "coeff.h"
template <typename T, size_t D>
void fillMatrix(const MeshPbc<T,D>& Mh,  const std::valarray<size_t>& num, matrix<T>& a, size_t ndof, const BCs& bc,
                //bool(*_isDirichlet)(size_t _dof) = [](size_t){return false;},
                T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje)
                //=[](const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, ssize_t kie, size_t kje){return T();}
                )
{
  //cout<<std::endl<<" calling fillmatrix"<<std::endl;
  for (size_t e = 0; e < Mh.getNumberOfElements(); e++) {
    size_t nv=Mh.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++) {
      for (size_t je = 0; je < nv; je++) {
            for (size_t kie = 0; kie < ndof; kie++){
            size_t i = ndof*(Mh.getElements()[e].getConnectivity()[ie]-1)+kie;
            if (bc.isDirichlet(i)) continue;
            a.at(num[i],num[i])   += matrixValue(Mh, e, ie, ie,kie, kie);
            // cout<<std::endl<<" calling fillmatrix : "<<  matrixValue(Th, e, ie, ie,kie, kie)<<std::endl;

            for (size_t kje = 0; kje < ndof; kje++){
                size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
                if (j == i || bc.isDirichlet(j)) continue;
                a.at(num[i],num[j]) += matrixValue(Mh, e, ie, je,kie,kje);

            }}
      }
    }
  }
}

template <typename T, size_t D>
void dimensionMatrixDir(const MeshPbc<T,D>& Mh, const std::valarray<size_t>& num, matrix<T>& a4,
matrix<T>& a14, matrix<T>& a24, matrix<T>& a34,
size_t ndof,const BCs& bc, std::vector<std::list<size_t> >& s4, std::vector<std::list<size_t> >& s14,
std::vector<std::list<size_t> >& s24, std::vector<std::list<size_t> >& s34)
{
  size_t nDir=bc.getDirNumber();  // dof number where dirichlet is applied
  size_t nRet=bc.getRetainedNumber();
  size_t nTied=bc.getTiedNumber();
  size_t nNotCstr=ndof*Mh.getNumberOfNodes()-nDir-nTied-nRet;
  size_t nNotDir=ndof*Mh.getNumberOfNodes()-nDir;
  size_t dirOffset=ndof*Mh.getNumberOfNodes()-bc.getDirNumber();
  s4.resize(nDir);
  s14.resize(nNotCstr);  s24.resize(nRet);  s34.resize(nTied);
  for (size_t e = 0; e < Mh.getNumberOfElements(); e++){
    size_t nv=Mh.getElements()[e].getElementSize();
    for (size_t ie = 0; ie < nv; ie++){
      for (size_t je = 0; je < nv; je++) {
            for (size_t kie = 0; kie < ndof; kie++){
            size_t i = ndof*(Mh.getElements()[e].getConnectivity()[ie] -1)+kie;

            if (bc.isDirichlet( i)) //dimension s41, s42, s43, s44 eq s4
            {unique_insert(s4[num[i]-dirOffset], num[i]);
            for (size_t kje = 0; kje < ndof; kje++){
                size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
                if (j == i ) continue;
                unique_insert (s4[num[i]-dirOffset], num[j]);}
            }

            else //dimension s14, s24, s34; they are all 3 off-diagonal

            {
            for (size_t kje = 0; kje < ndof; kje++){
                size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
                if ( (num[i]<nNotCstr) && (num[j] >= nNotDir) ) {unique_insert (s14[ num[i] ], num[j]-nNotDir);continue;}
                if (num[i]>=nNotCstr && num[i]<(nNotCstr+nRet) && num[j]>=nNotDir) {unique_insert (s24[ num[i] - nNotCstr], num[j]-nNotDir);continue;}
                if (num[i]>=(nNotCstr+nRet) && num[i]<(nNotCstr+nRet+nTied) && num[j]>=nNotDir) {unique_insert (s34[ num[i]-(nNotCstr+nRet) ], num[j]-nNotDir);continue;}
                }
            }


            }
      }

    }
  }
  a4.resize (s4, ndof*Mh.getNumberOfNodes());
  a14.resize(s14,nDir); a24.resize(s24, nDir); a34.resize(s34,nDir);
}

template <typename T, size_t D>
void fillMatrixDir(const MeshPbc<T,D>& Mh,  const std::valarray<size_t>& num, matrix<T>& a4, matrix<T>& a14,
                   matrix<T>& a24, matrix<T>& a34, size_t ndof, const BCs& bc,
T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje) )
{
  size_t nDir=bc.getDirNumber();  // dof number where dirichlet is applied
  size_t nRet=bc.getRetainedNumber();
  size_t nTied=bc.getTiedNumber();
  size_t nNotCstr=ndof*Mh.getNumberOfNodes()-nDir-nTied-nRet;
  size_t nNotDir=ndof*Mh.getNumberOfNodes()-nDir;

  size_t dirOffset=ndof*Mh.getNumberOfNodes()-bc.getDirNumber();
  for (size_t e = 0; e < Mh.getNumberOfElements(); e++) {
    size_t nv=Mh.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++) {
      for (size_t je = 0; je < nv; je++) {
            for (size_t kie = 0; kie < ndof; kie++){
            size_t i = ndof*(Mh.getElements()[e].getConnectivity()[ie]-1)+kie;
            if (bc.isDirichlet(i)) //Fill (K41, K42, K43, K44) eq a4
            {
            a4.at(num[i]-dirOffset,num[i])   += matrixValue(Mh, e, ie, ie,kie, kie);

            for (size_t kje = 0; kje < ndof; kje++){
                size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
                if (j == i ) continue;
                 a4.at(num[i]-dirOffset,num[j]) += matrixValue(Mh, e, ie, je,kie,kje);}
            }

            else//fill K14, K24, K34; they are all 3 off-diagonal

            {
            for (size_t kje = 0; kje < ndof; kje++){
                 size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
                 if (num[i]<nNotCstr && num[j]>=nNotDir) {a14.at(num[i], num[j]-nNotDir) += matrixValue(Mh, e, ie, je,kie,kje) ;continue;}
                 if ( num[i]>=nNotCstr && num[i]<(nNotCstr+nRet) && num[j]>=nNotDir) {a24.at(num[i] - nNotCstr, num[j]-nNotDir) += matrixValue(Mh, e, ie, je,kie,kje);continue;}
                 if (num[i]>=(nNotCstr+nRet) && num[i]<(nNotCstr+nRet+nTied) && num[j]>=nNotDir) {a34.at (num[i]-(nNotCstr+nRet) , num[j]-nNotDir) += matrixValue(Mh, e, ie, je,kie,kje);continue;}
            }
            }

            }
      }
    }
  }
}

//********************************* customAssembly
template <typename T, size_t D>
void customAssembly(const MeshPbc<T,D>& Mh, std::valarray<size_t>& num,
    matrix<T>& a, size_t ndof,const BCs& bc,
   // bool(*_isDirichlet)(size_t _ndof) = [](size_t){return false;},
    T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje)
    //=[](const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje){return T();}

    ){
    
    //Use "fillMatrix" and "dimensionMatrix" for matrix assembling
  std::vector<std::list<size_t> > s;
     dimensionMatrix(Mh, num, a, ndof, bc,s);
     fillMatrix(Mh, num,a, ndof, bc, matrixValue);
     //fillMatrix needs to implement the function matrixValue(Th, e, ie, je,k) 0<=k<ndof
     //_isDirichlet takes into account dirichlet boundary condition
    }

//********************************* matrix value

template <typename T, size_t D>
T matrixValueTetra(const MeshPbc<T,D>& Mh, size_t e,size_t ie, size_t je, size_t kie, size_t kje){
     double E, nu, lambda, mu;
     E=0.5; nu=0.3;
     lambda=(nu*E)/((1+nu)*(1-2*nu));
     mu=(E)/(2*(1+nu));

/*T N1(double xi, double eta, double zeta){return (1 - xi - eta - zeta);};
T N2(double xi, double eta, double zeta){return (xi);};
T N3(double xi, double eta, double zeta){return (eta);};
T N4(double xi, double eta, double zeta){return (zeta);};*/

//U(*)(double, double, double, double) tabN[4]={N1, N2, N3, N4};


double xA,yA,zA, xB,yB,zB, xC,yC,zC, xD,yD,zD,   detTau;
double A11,A22,A33, A12,A21, A13,A31, A23,A32; // commatrice coefficients
//xA=Th.getElements()[e].getConnectivity()[0]
xA=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[0] -1].getXi(0);
yA=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[0] -1].getXi(1);
zA=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[0] -1].getXi(2);

xB=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[1] -1].getXi(0);
yB=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[1] -1].getXi(1);
zB=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[1] -1].getXi(2);

xC=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[2] -1].getXi(0);
yC=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[2] -1].getXi(1);
zC=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[2] -1].getXi(2);

xD=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[3] -1].getXi(0);
yD=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[3] -1].getXi(1);
zD=Mh.getNodes()[ Mh.getElements()[e].getConnectivity()[3] -1].getXi(2);


detTau= (-xA+xB)*(-yA+yC)*(-zA+zD)-(-xA+xB)*(-zA+zC)*(-yA+yD) -(-yA+yB)*(-xA+xC)*(-zA+zD)+(-yA+yB)*(-zA+zC)*(-xA+xD) +(-zA+zB)*(-xA+xC)*(-yA+yD)-(-zA+zB)*(-yA+yC)*(-xA+xD);


A11=( (-yA+yC)*(-zA+zD) - (-zA+zC)*(-yA+yD) );
A22=( (-xA+xB)*(-zA+zD) - (-zA+zB)*(-xA+xD)  );
A33=( (-xA+xB)*(-yA+yC) - (-yA+yB)*(-xA+xC) );

A12=-1*( (-yA+yB)*(-zA+zD) - (-zA+zB)*(-yA+yD) );
A21=-1*( (-xA+xC)*(-zA+zD) - (-zA+zC)*(-xA+xD) );

A13=( (-yA+yB)*(-zA+zC) - (-zA+zB)*(-yA+yC) );
A31=( (-xA+xC)*(-yA+yD) - (-yA+yC)*(-xA+xD) );

A23=-1*( (-xA+xB)*(-zA+zC) - (-zA+zB)*(-xA+xC) );
A32=-1*( (-xA+xB)*(-yA+yD) - (-yA+yB)*(-xA+xD) );



//U GradN1{-1, -1, -1}; U GradN2{1, 0, 0}; U GradN3{0, 1, 0}; U GradN4{0, 0, 1};  // The real values must be gotten by multiplying every line by Grad xi/x.


T GradN1[]{(-A11-A12-A13)/detTau, (-A21-A22-A23)/detTau, (-A31-A32-A33)/detTau}; T GradN2[]{A11/detTau, A21/detTau, A31/detTau}; T GradN3[]{A12/detTau, A22/detTau, A32/detTau}; T GradN4[]{A13/detTau, A23/detTau, A33/detTau};  // The real values must be gotten by multiplying every line by Grad xi/x.


T tabGradN[4][3] = { {GradN1[0],GradN1[1],GradN1[2]}, {GradN2[0],GradN2[1],GradN2[2]}, {GradN3[0],GradN3[1],GradN3[2]}, {GradN4[0],GradN4[1],GradN4[2]} };

//return (tabGradN[ie][kie])*C*(tabGradN[je][kje]);

return detTau*( lambda*(tabGradN[ie][kie])*(tabGradN[je][kje]) + mu*( (tabGradN[ie][kje])*(tabGradN[je][kie]) +(kie==kje)*( (tabGradN[ie][0])*(tabGradN[je][0])+(tabGradN[ie][1])*(tabGradN[je][1])+(tabGradN[ie][2])*(tabGradN[je][2]) ) )  );

}


//*********************************customRsh

template <typename T, size_t D>
void customRhs(const MeshPbc<T,D>& Mh,  std::valarray<size_t>& num, std::valarray<T>& rhs, std::valarray<bool>& masq, size_t ndof,
const BCs& bc,
 //   bool(*_isDirichlet)(size_t _dof) = [](size_t){return false;},
    T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje)
    //=[](const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, ssize_t kie, size_t kje){return T();}
               )
{
size_t n;

//renumbering(Th,num, n,ndof,_isDirichlet);
  renumbering(Mh,num,n, ndof,bc);

rhs.resize(ndof*Mh.getNumberOfNodes(), 0.);
masq.resize(ndof*Mh.getNumberOfNodes(), 1);
for (size_t e = 0; e < Mh.getNumberOfElements(); e++) {
    size_t nv=Mh.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++) {
    for (size_t je = 0; je < nv; je++) {
      for (size_t kie = 0; kie < ndof; kie++){
        size_t i = ndof*(Mh.getElements()[e].getConnectivity()[ie]-1)+kie;
        if (/*Th.*/bc.isDirichlet(i)) continue;

        for (size_t kje = 0; kje < ndof; kje++){
        size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
        if (!bc.isDirichlet(j)) {masq[j]=0; continue;}
        rhs[num[i]] += -1*matrixValue(Mh, e, ie, je,kie,kje)*bc.PbCDirichletValue(j, ndof);

        }}
    }
    }
}
}


}
