#ifndef PBCUTILITIES_H
#define PBCUTILITIES_H

#include <QObject>
#include<MeshPbc.h>
#include<bitset>
#include<node.h>
#include<cmath>
#include<cassert>
#include<QDebug>
#include<bcs.h>
#include<valarray>
#include<vector>
#include<list>
#include<matrix.h>

namespace scaletag {
namespace models {

class PbcUtilities : public QObject
{
    Q_OBJECT
public:
    explicit PbcUtilities(QObject *parent = nullptr);
    void structBox(const MeshPbc<double,3>&, double& Xmin, double& Xmax, double& Ymin, double& Ymax, double& Zmin, double& Zmax) ;
    void nodesSelect(const MeshPbc<double,3>& meshPbc, /*string box,*/ bitset<6>bs, double epsi, vector<size_t>& Output) ;

    void edgesLinks(const MeshPbc<double,3>& meshPbc, const vector<size_t>& Sommets, int ind, const vector<size_t>& v1,
          const vector<size_t>& v2,double epsi, vector<array<size_t,3> >& sortie) ;

    void facesLinks(const MeshPbc<double,3>& meshPbc, const vector<size_t>& Sommets, int ind, const vector<size_t>& v1,
    const vector<size_t>& v2, double epsi, vector<array<size_t,3> >& sortie) ;

    void createPbcLinks(MeshPbc<double,3>& meshPbc, vector<array<size_t,3> >& pbcLinks, size_t& NbLinks,
    vector<size_t>& sommets) ;

    std::vector<std::list<size_t> > getMatrixStructure(const MeshPbc<double,3>& Th, const vector<array<size_t,3> >& pbcLinks,
      const std::valarray<size_t>& numPbc,const fem::BCs& bc, size_t ndof) const;

    void createConstraintMatrix(const MeshPbc<double,3>& Th, const vector<array<size_t,3> >& pbcLinks,
                                const std::valarray<size_t>& numPbc,const fem::BCs& bc, size_t ndof,
                                fem::matrix<double>& mat);
    void createConstraintVector(const MeshPbc<double,3>& Th, const vector<array<size_t,3> >& pbcLinks,
                                const std::valarray<size_t>& numPbc,const fem::BCs& bc, size_t ndof,
                                std::valarray<double>& vec);

signals:

};

} // namespace models
} // namespace scaletag

#endif // SCALETAG_MODELS_PBCUTILITIES_H
