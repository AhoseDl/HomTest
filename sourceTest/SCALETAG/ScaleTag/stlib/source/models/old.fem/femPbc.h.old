//*********************************unique_insert
template <typename T>
void unique_insert (std::list<T>& L, const T& j) ;


//*********************************renumbering
template<typename T, size_t D>
void renumbering(const MeshPbc<T,D>& Th, std::valarray<size_t>& num, size_t& _icount, size_t ndof,const BCs& bc);

//*********************************PASS1

template <typename T, size_t D>
QT_DEPRECATED void dimensionMatrixPbc(const MeshPbc<T,D>& Th, std::valarray<size_t>& num, matrix<T>& a, size_t ndof,const BCs& bc,vector<array<size_t,3>>& pbcLinks
   // bool(*_isDirichlet)(const BCs& bc,size_t _dof) = [](size_t){return false;})
                     )
{
  //size_t n = Th.n_internal_vertex();
  //size_t ndof;
  size_t n;  // dof number where dirichlet is not applied
  renumbering(Th,num,n, ndof,bc); // This to take into account dirichlet boundary condition
  std::vector<std::list<size_t> > s(n);
  size_t nGEqs = n-ndof*(pbcLinks.size());
  for (size_t e = 0; e < Th.getNumberOfElements(); e++){
  size_t nv=Th.getElements()[e].getElementSize();
  //for (size_t k = 0; k < ndof; k++){
  
    for (size_t ie = 0; ie < nv; ie++){
       for (size_t je = 0; je < nv; je++) {
            for (size_t kie = 0; kie < ndof; kie++){
                size_t i = ndof*(Th.getElements()[e].getConnectivity()[ie] -1)+kie;
                if (/*Th.*/bc.isDirichlet( i) || num[i]>nGEqs-1) continue;
                unique_insert(s[num[i]], num[i]);

            for (size_t kje = 0; kje < ndof; kje++){
                size_t j = ndof*(Th.getElements()[e].getConnectivity()[je]-1)+kje;
                if (j == i || /*Th.*/bc.isDirichlet(j)) continue;
                unique_insert (s[num[i]], num[j]);
            }}
        //i,j are degree of freedom numbers
      }

    }//End k
    }
   
   //Taking into account the periodic boundary conditions
    for(size_t pbcdof=0, npbc=0; npbc<pbcLinks.size(); npbc++){
    for(size_t kndof=0; kndof<ndof; kndof++){
    pbcdof++;
            for(size_t kpbc=0; kpbc<pbcLinks[npbc].size(); kpbc++){
            size_t jj=ndof*(pbcLinks[npbc][kpbc]) + kndof;
            if(bc.isDirichlet(jj))  continue;
            //s[num[nGEqs]+ndof*npbc+kndof].push_back(jj);
            //s[nGEqs+ndof*npbc+kndof].push_back(jj);
            s[nGEqs-1+pbcdof].push_back(num[jj]);
            }
    	
    }
    }
    
  a.resize (s, n);
}




//*********************************PBC matrix dimensioning

template <typename T, size_t D>
QT_DEPRECATED void dimMatPbc(const MeshPbc<T,D>& Th, std::valarray<size_t>& numPbc, matrix<T>& a, size_t ndof, BCs& bc,
               vector<array<size_t,3> >& pbcLinks/*,
               std::vector<std::list<size_t> >& s*/)
{
  //size_t n = Th.n_internal_vertex();
  //size_t ndof;
 // size_t n;  //dofs which do not include dirichlet

  size_t iNotDir;
  std::valarray<bool>masqDir;
  std::valarray<bool>masqTied;
  std::valarray<bool>masqRet;
  std::valarray<bool>masqNotConstrained;


  renumberingPbc(Th, numPbc, iNotDir, ndof, bc, masqDir, masqTied, masqRet ,masqNotConstrained);



std::vector<std::list<size_t> > s(iNotDir-bc.getTiedNumber());
  size_t iNotCstr=iNotDir-bc.getTiedNumber()-bc.getRetainedNumber();
  size_t colMax=iNotDir-bc.getTiedNumber();

  for (size_t e = 0; e < Th.getNumberOfElements(); e++){
    size_t nv=Th.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++){
            for (size_t je = 0; je < nv; je++) {
            for (size_t kie = 0; kie < ndof; kie++){
            size_t i = ndof*(Th.getElements()[e].getConnectivity()[ie] -1)+kie;
            //if (bc.isDirichlet(i)||bc.isTied(i)||bc.isRetained(i)) continue;
            if (numPbc[i]>=iNotCstr) continue;
            unique_insert(s[numPbc[i]], numPbc[i]);

            for (size_t kje = 0; kje < ndof; kje++){
                size_t j = ndof*(Th.getElements()[e].getConnectivity()[je]-1)+kje;
                //if (j == i || bc.isDirichlet(j)||bc.isTied(j)||bc.isRetained(j)) continue;
                if (j == i || numPbc[j]>=iNotCstr) continue;
                unique_insert (s[numPbc[i]], numPbc[j]);
            }}

            }

    }
  }  //End non constraint part

// Constraint part ; to be optimized
//  size_t iNotCstr=iNotDir-bc.getTiedNumber()-bc.getRetainedNumber();
  for(size_t nlign=0; nlign<iNotCstr; nlign++)
    for(size_t kcol=iNotCstr; kcol<colMax; kcol++) s[nlign].insert(s[nlign].end(),kcol);

  for(size_t nlign=iNotCstr; nlign<colMax; nlign++)
    for(size_t kcol=0; kcol<colMax; kcol++) s[nlign].insert(s[nlign].end(),kcol);



  a.resize (s, iNotDir-bc.getTiedNumber());
}

template <typename T, size_t D>
void fillMatPbc(const MeshPbc<T,D>& Th, std::valarray<size_t>& numPbc, const matrix<T>& galMat, const matrix<T>& constrMat, matrix<T>& a, size_t ndof, BCs& bc,
                vector<array<size_t,3> >& pbcLinks,std::vector<std::list<size_t> >& s){

  size_t iNotCstr =ndof*Th.getNumberOfNodes()-bc.getDirNumber()-bc.getTiedNumber()-bc.getRetainedNumber();
  size_t nTied=bc.getTiedNumber();
  size_t nRet=bc.getRetainedNumber();
  size_t colMax=ndof*Th.getNumberOfNodes()-bc.getDirNumber()-bc.getTiedNumber();
   size_t rowMax=colMax;

//Initialization
    for(size_t i=0; i<s.size(); i++)
    for(auto j=s[i].begin(); j!=s[i].end(); j++){
            if(i<rowMax && (*j)<colMax)    a.at(i,*j)=a(i,*j) + galMat(i,*j);
    }

//  // First quarter
//  for(size_t i=0; i<iNotCstr; i++)
//    for(size_t j=0; j<iNotCstr; j++){
//            a.at(i,j)=a(i,j) + galMat(i,j);
//    }

//Second quarter
   for(size_t i=0; i<iNotCstr; i++)
    for(size_t j=0; j<nRet; j++){
            T value=0;
            for(size_t k=0; k<nTied; k++) value=value+galMat(i, k+iNotCstr+nRet)*constrMat(k,j);
     a.at(i,j+iNotCstr)=a(i,j+iNotCstr) + value;
    }

//Third quarter
   for(size_t i=0; i<nRet; i++)
    for(size_t j=0; j<nRet; j++){

     T value1=0, value2=0, value3=0;

//        for(size_t k=0; k<nTied; k++) value1=value1+constrMat(k,i)*galMat(k+iNotCstr+nRet,j+iNotCstr);
//        for(size_t k=0; k<nTied; k++) value2=value2+galMat(i+iNotCstr,k+iNotCstr+nRet)*constrMat(k,j);
//        for(size_t k=0; k<nTied; k++) for(size_t l=0; l<nTied; l++) value3=value3+ constrMat(k+iNotCstr+nRet,l+iNotCstr+nRet)*galMat(i+iNotCstr,k+iNotCstr+nRet)*constrMat(l,j);
     for(size_t k=0; k<nTied; k++){
            value1=value1+constrMat(k,i)*galMat(k+iNotCstr+nRet,j+iNotCstr);
            value2=value2+galMat(i+iNotCstr,k+iNotCstr+nRet)*constrMat(k,j);
            for(size_t l=0; l<nTied; l++) value3=value3+ constrMat(k+iNotCstr+nRet,l+iNotCstr+nRet)*galMat(i+iNotCstr,k+iNotCstr+nRet)*constrMat(l,j);
     }
     a.at(i+iNotCstr,j+iNotCstr)=a(i+iNotCstr,j+iNotCstr) + value1+value2+value3;


    }

//Fourth quarter
   for(size_t i=0; i<nRet; i++)
    for(size_t j=0; j<iNotCstr; j++){
        T value=0;
        for(size_t k=0; k<nTied; k++) value=value + constrMat(k,i)*galMat(k+iNotCstr+nRet,j);
     a.at(i+iNotCstr,j)=a(i+iNotCstr,j) + value;
    }

}


//*********************************PASS2

//#include "coeff.h"
template <typename T, size_t D>
QT_DEPRECATED void fillMatrixPbc(const MeshPbc<T,D>& Th,  std::valarray<size_t>& num, matrix<T>& a, size_t ndof, const BCs& bc,
vector<array<size_t,3>>& pbcLinks,//bool(*_isDirichlet)(size_t _dof) = [](size_t){return false;},
T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje)
//=[](const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, ssize_t kie, size_t kje){return T();}
                )
    {
  //cout<<std::endl<<" calling fillmatrix"<<std::endl;

  size_t n;  // dof number where dirichlet is not applied
  renumbering(Th,num,n, ndof,bc); // This to take into account dirichlet boundary condition

  size_t nGEqs = n-ndof*(pbcLinks.size());
  for (size_t e = 0; e < Th.getNumberOfElements(); e++) {
  size_t nv=Th.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++) {
    for (size_t je = 0; je < nv; je++) {
      for (size_t kie = 0; kie < ndof; kie++){
        size_t i = ndof*(Th.getElements()[e].getConnectivity()[ie]-1)+kie;
        if (bc.isDirichlet(i)|| num[i]>nGEqs-1) continue;
        a.at(num[i],num[i])   += matrixValue(Th, e, ie, ie,kie, kie);
        // cout<<std::endl<<" calling fillmatrix : "<<  matrixValue(Th, e, ie, ie,kie, kie)<<std::endl;

      for (size_t kje = 0; kje < ndof; kje++){
        size_t j = ndof*(Th.getElements()[e].getConnectivity()[je]-1)+kje;
                if (j == i || bc.isDirichlet(j)) continue;
        a.at(num[i],num[j]) += matrixValue(Th, e, ie, je,kie,kje);

        }}
    }
    }
  }
  
     //Taking into account the periodic boundary conditions
    for(size_t pbcdof=0, npbc=0; npbc<pbcLinks.size(); npbc++){
    for(size_t kndof=0; kndof<ndof; kndof++){
    pbcdof++;
    for(size_t kpbc=0; kpbc<pbcLinks[npbc].size(); kpbc++){
      size_t jj=ndof*(pbcLinks[npbc][kpbc]) + kndof;
      if(bc.isDirichlet(jj))  continue;
        //s[num[nGEqs]+kpbc].push_back(ii);
        //a.at(num[nGEqs]+ndof*npbc+kndof,jj) = (kpbc==0 ? 1 : -1);
         //a.at(nGEqs+ndof*npbc+kndof,jj) = (kpbc==0 ? 1 : -1);
         a.at(nGEqs-1+pbcdof,num[jj]) = (kpbc==0 ? 1 : -1);
        }
    	
    }
    }
}

//*********************************customRshPbc

template <typename T, size_t D>
QT_DEPRECATED void customRhsPbc(const MeshPbc<T,D>& Mh,  std::valarray<size_t>& num, std::valarray<T>& rhs, std::valarray<bool>& masq, size_t ndof,
const BCs& bc,vector<array<size_t,3>>& pbcLinks,
 //   bool(*_isDirichlet)(size_t _dof) = [](size_t){return false;},
    T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje)
    //=[](const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, ssize_t kie, size_t kje){return T();}
               )
{
size_t n; //number of dofs without dirichlet

//renumbering(Th,num, n,ndof,_isDirichlet);
  renumbering(Mh,num,n, ndof,bc);

rhs.resize(ndof*Mh.getNumberOfNodes(), 0.);
masq.resize(ndof*Mh.getNumberOfNodes(), 1);
size_t nndof=ndof*Mh.getNumberOfNodes();// ndof per node; total number of dofs
for(size_t i=0; i<nndof; i++){if(!bc.isDirichlet(i)) masq[i]=0;}

size_t nGEqs = n-ndof*(pbcLinks.size());  //number of dofs without dirichlet and pbcs
for (size_t e = 0; e < Mh.getNumberOfElements(); e++) {
    size_t nv=Mh.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++) {
    for (size_t je = 0; je < nv; je++) {
      for (size_t kie = 0; kie < ndof; kie++){
        size_t i = ndof*(Mh.getElements()[e].getConnectivity()[ie]-1)+kie;
        if (/*Th.*/!bc.isDirichlet(i)/*|| num[i]>nGEqs-1*/) continue;

        for (size_t kje = 0; kje < ndof; kje++){
        size_t j = ndof*(Mh.getElements()[e].getConnectivity()[je]-1)+kje;
        if (bc.isDirichlet(j)) //{/*masq[j]=0;*/ continue;}
        rhs[i] += -1*matrixValue(Mh, e, ie, je,kie,kje)*bc.PbCDirichletValue(j, ndof);

        }}
    }
    }
}


     //Taking into account the periodic boundary conditions
    for(size_t pbcdof=0, npbc=0; npbc<pbcLinks.size(); npbc++){
    for(size_t kndof=0; kndof<ndof; kndof++){
        pbcdof++;
            for(size_t kpbc=0; kpbc<pbcLinks[npbc].size(); kpbc++){
            size_t jj=ndof*(pbcLinks[npbc][kpbc]) + kndof;
            if(bc.isDirichlet(jj))  rhs[nGEqs-1+pbcdof /*ndof*npbc+kndof*/] =-1*bc.PbCDirichletValue(jj, ndof);//rhs[num[nGEqs]+ndof*npbc+kndof] =bc.PbCDirichletValue(jj, ndof);
            else
            //rhs[nGEqs+ndof*npbc+kndof]=0;//rhs[num[nGEqs]+ndof*npbc+kndof]=0;
            rhs[nGEqs-1+pbcdof]=0;//rhs[num[nGEqs]+ndof*npbc+kndof]=0;

            }
    	
    }
    }
}

//********************************* customAssembly
template <typename T, size_t D>
QT_DEPRECATED void customAssemblyPbc(const MeshPbc<T,D>& Th, std::valarray<size_t>& num,
    matrix<T>& a, size_t ndof,const BCs& bc, vector<array<size_t,3>>& pbcLinks,
   // bool(*_isDirichlet)(size_t _ndof) = [](size_t){return false;},
    T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje)
    //=[](const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje){return T();}

    ){
    
    //Use "fillMatrix" and "dimensionMatrix" for matrix assembling
    
     dimensionMatrixPbc(Th, num, a, ndof, bc, pbcLinks);
     fillMatrixPbc(Th, num,a, ndof, bc, pbcLinks, matrixValue);
     //fillMatrix needs to implement the function matrixValue(Th, e, ie, je,k) 0<=k<ndof
     //_isDirichlet takes into account dirichlet boundary condition
    }

//********************************* Rigidity splitting

        template <typename T, size_t D>
    QT_DEPRECATED void KSplit(const MeshPbc<T,D>& Th, std::valarray<size_t>& numPbc,
    matrix<T>& a, size_t ndof, BCs& bc, vector<pbcEquation>& pbcLinks,
    T (*matrixValue)(const MeshPbc<T,D>& Th,size_t e,size_t ie, size_t je, size_t kie, size_t kje),
        matrix<T>& K11,matrix<T>& K12,matrix<T>& K13,matrix<T>& K21,matrix<T>& K22,matrix<T>& K23,
        matrix<T>& K31,matrix<T>& K32,matrix<T>& K33
                     ){
     pbcLinks.clear();
     matrix<T> galMat;
     matrix<T> constrMat;
     std::valarray<double> constrVec;
     std::vector<std::list<size_t> > galMatStruct;

     //std::valarray<size_t> numPbc;
     size_t nNotDir;
     std::valarray<bool>masqDir;
     std::valarray<bool>masqTied;
     std::valarray<bool>masqRet;
     std::valarray<bool> masqNotConstrained;
     size_t NbLinks; vector<size_t> sommets;
     scaletag::models::PbcUtilities pbc;
     pbc.createPbcLinks(Th,pbcLinks, NbLinks, sommets);
     bc.setSommets(sommets);
     bc.setTractionX(3);
     bc.setPbc(pbcLinks, ndof);
     renumberingPbc(Th, numPbc, nNotDir, ndof, bc, masqDir, masqTied, masqRet, masqNotConstrained);

     size_t nNotCstr = nNotDir-bc.getTiedNumber()-bc.getRetainedNumber();
     size_t nRet = bc.getRetainedNumber();
     size_t nTied = bc.getTiedNumber();

     std::vector<std::list<size_t> > s11( nNotCstr ), s12( nNotCstr ), s13( nNotCstr );
     std::vector<std::list<size_t> > s21(nRet), s22( nRet ), s23( nRet );
     std::vector<std::list<size_t> > s31( nTied ), s32( nTied ), s33( nTied );


     //Start dimensionning
    for (size_t e = 0; e < Th.getNumberOfElements(); e++){
    size_t nv=Th.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++){
        for (size_t je = 0; je < nv; je++) {
        for (size_t kie = 0; kie < ndof; kie++){
        size_t i = ndof*(Th.getElements()[e].getConnectivity()[ie] -1)+kie;

        if (bc.isDirichlet(i)) continue;
        if(numPbc[i]<nNotCstr) {unique_insert(s11[numPbc[i]], numPbc[i]); /*continue;*/} else
        if( numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet) ) {unique_insert(s22[numPbc[i]-nNotCstr], numPbc[i]-nNotCstr); /*continue;*/} else
        if(numPbc[i]>=(nNotCstr+nRet)) {unique_insert(s33[numPbc[i]-(nNotCstr+nRet)], numPbc[i]-(nNotCstr+nRet)); /*continue;*/}

            for (size_t kje = 0; kje < ndof; kje++){

            size_t j = ndof*(Th.getElements()[e].getConnectivity()[je]-1)+kje;
            if (j == i || bc.isDirichlet(j)) continue;

            if( numPbc[i]<nNotCstr && numPbc[j]<nNotCstr ) {unique_insert(s11[numPbc[i]], numPbc[j]); continue;}
            if( numPbc[i]<nNotCstr && numPbc[j]>=nNotCstr && numPbc[j]<(nNotCstr+nRet) ) {unique_insert(s12[numPbc[i]], numPbc[j]-nNotCstr); continue;}
            if( numPbc[i]<nNotCstr && numPbc[j]>=(nNotCstr+nRet) ) {unique_insert(s13[numPbc[i]], numPbc[j]-(nNotCstr+nRet)); continue;}

            if(numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet)&& numPbc[j]<nNotCstr ) {unique_insert(s21[numPbc[i]-nNotCstr],numPbc[j]); continue;}
            if(numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet)&& numPbc[j]>=nNotCstr && numPbc[j]<(nNotCstr+nRet) ) {unique_insert(s22[numPbc[i]-nNotCstr],numPbc[j]-nNotCstr); continue;}
            if(numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet)&& numPbc[j]>=(nNotCstr+nRet) ) {unique_insert(s23[numPbc[i]-nNotCstr],numPbc[j]-(nNotCstr+nRet)); continue;}

            if(numPbc[i]>=(nNotCstr+nRet) && numPbc[j]<nNotCstr ) {unique_insert(s31[numPbc[i]-(nNotCstr+nRet)],numPbc[j]); continue;}
            if(numPbc[i]>=(nNotCstr+nRet) && numPbc[j]>=nNotCstr && numPbc[j]<(nNotCstr+nRet) ) {unique_insert(s32[numPbc[i]-(nNotCstr+nRet)],numPbc[j]-nNotCstr); continue;}
            if(numPbc[i]>=(nNotCstr+nRet) && numPbc[j]>=(nNotCstr+nRet) ) {unique_insert(s33[numPbc[i]-(nNotCstr+nRet)],numPbc[j]-(nNotCstr+nRet)); continue;}

            }}
            K11.resize(s11, nNotCstr); K12.resize(s11, nRet); K13.resize(s13, nTied);
            K21.resize(s11, nNotCstr); K22.resize(s11, nRet); K23.resize(s13, nTied);
            K31.resize(s11, nNotCstr); K32.resize(s11, nRet); K33.resize(s13, nTied);
            }
    }} //End of Dimensionning

    //Start filling
    for (size_t e = 0; e < Th.getNumberOfElements(); e++) {
    size_t nv=Th.getElements()[e].getElementSize();

    for (size_t ie = 0; ie < nv; ie++) {
            for (size_t je = 0; je < nv; je++) {
            for (size_t kie = 0; kie < ndof; kie++){
            size_t i = ndof*(Th.getElements()[e].getConnectivity()[ie]-1)+kie;

            if (bc.isDirichlet(i)) continue;
            if(numPbc[i]<nNotCstr) {K11.at(numPbc[i], numPbc[i] += matrixValue(Th, e, ie, ie,kie, kie)); /*continue;*/} else
            if( numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet) ) {K22.at(numPbc[i]-nNotCstr,numPbc[i]-nNotCstr)+= matrixValue(Th, e, ie, ie,kie, kie); /*continue;*/} else
            if(numPbc[i]>=(nNotCstr+nRet)) {K33.at(numPbc[i]-(nNotCstr+nRet), numPbc[i]-(nNotCstr+nRet) ) += matrixValue(Th, e, ie, ie,kie, kie); /*continue;*/}

            for (size_t kje = 0; kje < ndof; kje++){
            size_t j = ndof*(Th.getElements()[e].getConnectivity()[je]-1)+kje;
            if (j == i || bc.isDirichlet(j)) continue;
            //a.at(num[i],num[j]) += matrixValue(Th, e, ie, je,kie,kje);
            if( numPbc[i]<nNotCstr && numPbc[j]<nNotCstr ) {K11.at(numPbc[i],numPbc[j]) += matrixValue(Th, e, ie, je,kie,kje); continue;}
            if( numPbc[i]<nNotCstr && numPbc[j]>=nNotCstr && numPbc[j]<(nNotCstr+nRet) ) {K12.at(numPbc[i],numPbc[j]-nNotCstr)+= matrixValue(Th, e, ie, je,kie,kje); continue;}
            if( numPbc[i]<nNotCstr && numPbc[j]>=(nNotCstr+nRet) ) {K13.at(numPbc[i],numPbc[j]-(nNotCstr+nRet))+= matrixValue(Th, e, ie, je,kie,kje); continue;}

            if(numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet)&& numPbc[j]<nNotCstr ) {K21.at(numPbc[i]-nNotCstr, numPbc[j]) += matrixValue(Th, e, ie, je,kie,kje); continue;}
            if(numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet)&& numPbc[j]>=nNotCstr && numPbc[j]<(nNotCstr+nRet) ) {K22.at(numPbc[i]-nNotCstr, numPbc[j]-nNotCstr) += matrixValue(Th, e, ie, je,kie,kje); continue;}
            if(numPbc[i]>=nNotCstr && numPbc[i]<(nNotCstr+nRet)&& numPbc[j]>=(nNotCstr+nRet) ) {K23.at(numPbc[i]-nNotCstr, numPbc[j]-(nNotCstr+nRet)) += matrixValue(Th, e, ie, je,kie,kje); continue;}

            if(numPbc[i]>=(nNotCstr+nRet) && numPbc[j]<nNotCstr ) {K31.at(numPbc[i]-(nNotCstr+nRet), numPbc[j]) += matrixValue(Th, e, ie, je,kie,kje); continue;}
            if(numPbc[i]>=(nNotCstr+nRet) && numPbc[j]>=nNotCstr && numPbc[j]<(nNotCstr+nRet) ) {K32.at(numPbc[i]-(nNotCstr+nRet), numPbc[j]-nNotCstr) += matrixValue(Th, e, ie, je,kie,kje); continue;}
            if(numPbc[i]>=(nNotCstr+nRet) && numPbc[j]>=(nNotCstr+nRet) ) { K33.at(numPbc[i]-(nNotCstr+nRet),numPbc[j]-(nNotCstr+nRet)) += matrixValue(Th, e, ie, je,kie,kje);continue;}



            }}
            }
    }
    }
    //End filling
    }

    template<typename T,size_t D>
    void AssemblyPbc(const MeshPbc<T,D>& Mh, const std::valarray<size_t>& numPbc, const matrix<T>& matGal,  const matrix<T>& constrMat,
const std::valarray<T>& constrVec,  const matrix<T>& K14, const matrix<T>&K24, const matrix<T>& K34,
 size_t ndof,const BCs& bc, /*vector<pbcEquation>& pbcLinks,*/ const scaletag::models::PbcUtilities& pbc,
std::vector<std::list<size_t> >& s11, std::vector<std::list<size_t> >& s12,
std::vector<std::list<size_t> >& s13, std::vector<std::list<size_t> >& s21,
std::vector<std::list<size_t> >& s22, std::vector<std::list<size_t> >& s23,
 std::vector<std::list<size_t> >& s31, std::vector<std::list<size_t> >& s32,
std::vector<std::list<size_t> >& s33, matrix<T>& res, std::valarray<T>& redRhs){

    size_t nColGal;
    size_t sl1=ndof*Mh.getNumberOfNodes()-bc.getDirNumber()-bc.getTiedNumber()-bc.getRetainedNumber(),
        sl2=bc.getRetainedNumber(), sl3=bc.getTiedNumber();

    std::vector<std::list<size_t> > s; //Structure of the galerkin matrix
    matGal.getRowStruct(s, nColGal);

//splitting the galerkin matrix
    std::vector<std::list<size_t> > s1, s2, s3;
    s1.assign(s.begin(), s.begin()+sl1);
    s2.assign(s.begin()+sl1, s.begin()+sl1+sl2);
    s3.assign(s.begin()+sl1+sl2, s.end());

    s11.resize(sl1); s12.resize(sl1); s13.resize(sl1);
    s21.resize(sl2); s22.resize(sl2); s23.resize(sl2);
    s31.resize(sl3); s32.resize(sl3); s33.resize(sl3);

    // These predicates help splitting the 3 rows s1, s2, s3 to s11, s12, ..., s33
    auto pred1=[sl1](size_t i){ if(i>=sl1) return true; return false;};
    auto pred2=[sl1, sl2](size_t i){ if( i>=(sl1+sl2) ) return true; return false;};
    std::list<size_t>::iterator it1, it2;

    for(size_t i=0; i<sl1; i++){
    it1=std::find_if(s1[i].begin(), s1[i].end(),pred1);
    it2=std::find_if(it1, s1[i].end(),pred2);
    s11[i].assign(s1[i].begin(),it1);
    s12[i].assign(it1,it2);
    s13[i].assign(it2,s1[i].end());
    }
    for(size_t i=0; i<sl2; i++){
    it1=std::find_if(s2[i].begin(), s2[i].end(),pred1);
    it2=std::find_if(it1, s2[i].end(),pred2);
    s21[i].assign(s2[i].begin(),it1);
    s22[i].assign(it1,it2);
    s23[i].assign(it2,s2[i].end());
    }
    for(size_t i=0; i<( s.size()-(sl1+sl2) ); i++){
    it1=std::find_if(s3[i].begin(), s3[i].end(),pred1);
    it2=std::find_if(it1, s3[i].end(),pred2);
    s31[i].assign(s3[i].begin(),it1);
    s32[i].assign(it1,it2);
    s33[i].assign(it2,s3[i].end());
    }
 //The 2 functions minus1 and minus 2 help the columns indexes in s11, s12, ..., s33 start from 0
    auto minus1=[sl1](size_t& i){return i-=sl1;};
    auto minus2=[sl1,sl2](size_t& i){return i-=(sl1+sl2);};

    for(size_t i=0; i<sl1; i++){
            std::for_each(s12[i].begin(), s12[i].end(), minus1);
            std::for_each(s13[i].begin(), s13[i].end(), minus2);
        }
    for(size_t i=0; i<sl2; i++){
            std::for_each(s22[i].begin(), s22[i].end(), minus1);
            std::for_each(s23[i].begin(), s23[i].end(), minus2);
    }
    for(size_t i=0; i<sl3; i++){
            std::for_each(s32[i].begin(), s32[i].end(), minus1);
            std::for_each(s33[i].begin(), s33[i].end(), minus2);
    }

    matrix<T> K11, K12, K13, K21, K22, K23, K31, K32, K33;
    K11.resize(s11,sl1); K21.resize(s21,sl1); K31.resize(s31,sl1);
    K12.resize(s12,sl2); K22.resize(s22,sl2); K32.resize(s32,sl2);
    K13.resize(s13,sl3); K23.resize(s23,sl3); K33.resize(s33,sl3);

    //Filling K11, K12, ..., K33 from matGal
    for(size_t i=0; i<s11.size(); i++) for(auto j=s11[i].begin(); j!=s11[i].end(); j++)
            K11.at(i,*j) = matGal(i,*j);

    for(size_t i=0; i<s12.size(); i++) for(auto j=s12[i].begin(); j!=s12[i].end(); j++)
            K12.at(i,*j) = matGal(i,*j + sl1);

    for(size_t i=0; i<s13.size(); i++) for(auto j=s13[i].begin(); j!=s13[i].end(); j++)
            K13.at(i,*j) = matGal(i,*j + sl1+sl2);
    //****************************************
    for(size_t i=0; i<s21.size(); i++) for(auto j=s21[i].begin(); j!=s21[i].end(); j++)
            K21.at(i,*j) = matGal(i+sl1,*j);

    for(size_t i=0; i<s22.size(); i++) for(auto j=s22[i].begin(); j!=s22[i].end(); j++)
            K22.at(i,*j) = matGal(i+sl1,*j + sl1);

    for(size_t i=0; i<s23.size(); i++) for(auto j=s23[i].begin(); j!=s23[i].end(); j++)
            K23.at(i,*j) = matGal(i+sl1,*j + sl1+sl2);
    //******************************************
    for(size_t i=0; i<s31.size(); i++) for(auto j=s31[i].begin(); j!=s31[i].end(); j++)
            K31.at(i,*j) = matGal(i+sl1+sl2,*j);

    for(size_t i=0; i<s32.size(); i++) for(auto j=s32[i].begin(); j!=s32[i].end(); j++)
            K32.at(i,*j) = matGal(i+sl1+sl2,*j + sl1);

    for(size_t i=0; i<s33.size(); i++) for(auto j=s33[i].begin(); j!=s33[i].end(); j++)
            K33.at(i,*j) = matGal(i+sl1+sl2,*j + sl1+sl2);
    //********************************************

    matrix<T> KRed11, KRed12, KRed21, KRed22;
    //KRed22=((K22.plus(((constrMat.transpose()).mult(K32)))).plus((K23.mult(constrMat)))).plus((((constrMat.transpose()).mult(K33))).mult(constrMat));
    KRed11 = K11;
    KRed12 = K12 + K13*constrMat;
    KRed21 = K21 + (constrMat.transpose())*K31;
    KRed22 = K22 + (constrMat.transpose())*K32 + K23*constrMat + (constrMat.transpose())*K33*constrMat ;

    //Construction and filling of the reduced matrix res

    std::vector<std::list<size_t> >sRed11, sRed12, sRed21, sRed22;
    size_t ncolRed11, ncolRed12, ncolRed21, ncolRed22;
    KRed11.getRowStruct(sRed11, ncolRed11); KRed12.getRowStruct(sRed12, ncolRed12);
    KRed21.getRowStruct(sRed21, ncolRed21); KRed22.getRowStruct(sRed22, ncolRed22);

    auto add1=[sl1](size_t& i){return i+=sl1;};
    //auto minus2=[sl1,sl2](size_t& i){return i-=(sl1+sl2);};
    std::vector<std::list<size_t> > sRed12Abs=sRed12, sRed22Abs=sRed22;

    for(size_t i=0; i<sl1; i++){std::for_each(sRed12Abs[i].begin(), sRed12Abs[i].end(), add1);}
    for(size_t i=0; i<sl2; i++){std::for_each(sRed22Abs[i].begin(), sRed22Abs[i].end(), add1);}

    std::vector<std::list<size_t> > resStruct(sl1+sl2);
    for(size_t i=0; i<sl1; i++){
            //std::merge(sRed11[i].begin(),sRed11[i].end(), sRed12Abs[i].begin(), sRed12Abs[i].end(), std::back_inserter(resStruct[i]));
            std::copy(sRed11[i].begin(),sRed11[i].end(),std::back_inserter(resStruct[i]));
            std::copy(sRed12Abs[i].begin(), sRed12Abs[i].end(),std::back_inserter(resStruct[i]));
    }
    for(size_t i=0; i<sl2; i++){
    //   std::merge(sRed21[i].begin(),sRed21[i].end(), sRed22Abs[i].begin(), sRed22Abs[i].end(), std::back_inserter(resStruct[i]));
    std::copy(sRed21[i].begin(),sRed21[i].end(),std::back_inserter(resStruct[i+sl1]));
    std::copy(sRed22Abs[i].begin(), sRed22Abs[i].end(),std::back_inserter(resStruct[i+sl1]));

    }
    res.resize(resStruct, sl1+sl2);
    //Filling res from KRed11, KRed12, ..., KRed22
    for(size_t i=0; i<sRed11.size(); i++) for(auto j=sRed11[i].begin(); j!=sRed11[i].end(); j++)
            res.at(i,*j) = KRed11(i,*j);

    for(size_t i=0; i<sRed12.size(); i++) for(auto j=sRed12[i].begin(); j!=sRed12[i].end(); j++)
            res.at(i,*j+sl1) = KRed12(i,*j);

    for(size_t i=0; i<sRed21.size(); i++) for(auto j=sRed21[i].begin(); j!=sRed21[i].end(); j++)
            res.at(i+sl1,*j) = KRed21(i,*j);

    for(size_t i=0; i<sRed22.size(); i++) for(auto j=sRed22[i].begin(); j!=sRed22[i].end(); j++)
            res.at(i+sl1,*j+sl1) = KRed22(i,*j);
    //********************************************


    std::valarray<T> galRhs, galRhs1, galRhs2, galRhs3;
    rhsPbc(Mh, K14, K24, K34, bc, pbc, ndof, galRhs, galRhs1, galRhs2, galRhs3);
    std::valarray<T> redRhs1=galRhs1 -1*(K13*constrVec);
    std::valarray<T> redRhs2=galRhs2 + (constrMat.transpose())*galRhs3 -1*(K23*constrVec) -((constrMat.transpose())*(K33*constrVec));
    redRhs.resize(sl1+sl2,0);
    for(size_t i=0; i<sl1; i++) redRhs[i]=redRhs1[i];
    for(size_t i=0; i<sl2; i++) redRhs[i+sl1]=redRhs2[i];

    }

    //********************************* rhs computing for pbc
    template <typename T, size_t D>
    void rhsPbc(const MeshPbc<T,D>& Mh, const matrix<T>& K14,const matrix<T>& K24,const matrix<T>& K34,
    const BCs& bc, const scaletag::models::PbcUtilities& pbc, size_t ndof, std::valarray<T>& galRhs,
std::valarray<T>& galRhs1,std::valarray<T>& galRhs2,std::valarray<T>& galRhs3)
    {
    //galRhs doesnt inclue dirichlet rhs values
    galRhs.resize(ndof*Mh.getNumberOfNodes()-bc.getDirNumber(), 0);

    std::vector<size_t> dirdofs=bc.getDirichletDofs();
    std::valarray<T> dirValuesVec(dirdofs.size());
    for(size_t i=0; i<dirdofs.size(); i++) dirValuesVec[i]= bc.PbCDirichletValue(dirdofs[i], ndof);
    galRhs1=-1*(K14*dirValuesVec);
    galRhs2=-1*(K24*dirValuesVec);
    galRhs3=-1*(K34*dirValuesVec);

    }

//********************************* pbc Disp Value
    template <typename T, size_t D>
    void pbcDispValue(MeshPbc<T,D>& Mh, std::valarray<size_t>& numPbc,
        matrix<T>& a, size_t ndof, BCs& bc, vector<pbcEquation>& pbcLinks,
        T (*matrixValue)(const MeshPbc<T,D>& Mh,size_t e,size_t ie, size_t je, size_t kie, size_t kje),
                      std::valarray<T>& disp
    ){
     //Use "fillMatrix" and "dimensionMatrix" for matrix assembling
     pbcLinks.clear();
     matrix<T> galMat;
     matrix<T> constrMat;
     std::valarray<double> constrVec;
     std::vector<std::list<size_t> > galMatStruct;
         //, pbcMatStruct;
//     std::valarray<size_t> numPbc;
//     std::valarray<size_t> numPbcRel;
     size_t nNotDir;
     std::valarray<bool>masqDir;
     std::valarray<bool>masqTied;
     std::valarray<bool>masqRet;
     std::valarray<bool> masqNotConstrained;
     size_t NbLinks; vector<size_t> sommets;
     scaletag::models::PbcUtilities pbc;

     pbc.createPbcLinks(Mh,pbcLinks, NbLinks, sommets);
     bc.setSommets(sommets);
     bc.setTractionX(3);
     bc.setPbc(pbcLinks, ndof);
     renumberingPbc(Mh, numPbc, nNotDir, ndof, bc, masqDir, masqTied, masqRet, masqNotConstrained);
     fem::dimensionMatrix(Mh, numPbc, galMat, ndof, bc, galMatStruct); //galMatStruct={{K11,K12,K13},{K21,K22,K33},{K31, K32, K33}}
     fem::fillMatrix(Mh, numPbc, galMat, ndof, bc, matrixValue); //fill galMatStruct

     //matrices elements with relation with dirichlet dofs
     matrix<T> dirMat4,dirMat14,dirMat24,dirMat34;

     std::vector<std::list<size_t> > dirMatStruct4, dirMatStruct14,dirMatStruct24,dirMatStruct34;
     fem::dimensionMatrixDir(Mh, numPbc, dirMat4,dirMat14,dirMat24,dirMat34, ndof, bc, dirMatStruct4, dirMatStruct14,dirMatStruct24,dirMatStruct34);
     fem::fillMatrixDir(Mh, numPbc, dirMat4,dirMat14,dirMat24,dirMat34, ndof, bc, matrixValue);

     pbc.createConstraintMatrix(Mh, pbcLinks, numPbc, bc, ndof, constrMat);  //gamma
     pbc.createConstraintVector(Mh,pbcLinks,numPbc, bc, ndof,constrVec);//S

     std::vector<std::list<size_t> > s11,s12,s13,s21,s22,s23,s31,s32,s33;
     matrix<T> redMat;
     std::valarray<T> redRhs;
     AssemblyPbc(Mh,numPbc,galMat, constrMat,constrVec,dirMat14,dirMat24,dirMat34,
     ndof, bc,/*pbcLinks,*/ pbc, s11, s12,s13,s21,s22,s23,s31,s32,s33,redMat, redRhs);

     scaletag::fem::GeneralSolver<double> solver;
     solver.solveMumpsAssembledNonSym(redMat,redRhs);

// Evaluation of displacement vector
     disp.resize(ndof*Mh.getNumberOfNodes(),0);
     std::valarray<bool> masqRed=(masqNotConstrained||masqRet);
     disp[masqRed]=solver.getSolution();
     std::valarray<T>retValues=disp[masqRet];
     disp[masqTied]=constrMat*(retValues) + constrVec;

     std::vector<size_t> dirdofs=bc.getDirichletDofs();
     //std::sort(dirdofs.begin(), dirdofs.end()); //already sorted when invoking setTractionX,.., setCisYZ etc.
     std::valarray<T> dirValuesVec(dirdofs.size());
     for(size_t i=0; i<dirdofs.size(); i++) dirValuesVec[i]= bc.PbCDirichletValue(dirdofs[i], ndof);
     disp[masqDir]=dirValuesVec; //from bc DirichletValues
     //renumberingPbcRel(Th, numPbcRel, nNotDir, ndof, bc, masqDir, masqTied, masqRet, masqNotConstrained);

// Evaluation of nodal forces at retained nodes

     std::valarray<T> rhsDir=dirMat4*disp;



     {    //a.resize(pbc.getMatrixStructure(Th, pbcLinks, numPbc, bc, ndof), bc.getRetainedNumber());
     //pbc.createConstraintVector(Mh,pbcLinks,numPbc, bc, ndof,constrVec); //S
    // dimMatPbc(Th, numPbc, a, ndof, bc,pbcLinks/*,pbcMatStruct*/);
    //fillMatPbc(Th, numPbc, galMat,constrMat, a, ndof, bc,pbcLinks,galMatStruct);

    //matrix<T> K11,K12,K13,K21, K22, K23, K31, K32,K33;
    //KSplit(Th, numPbc,a, ndof, bc, pbcLinks,matrixValue,K11,K12,K13,K21,K22,K23,K31,K32,K33);

     }


{//     std::valarray<double> val1{1,2,1,2,3}, val2{2,1,1,2,3};
//     std::valarray<size_t> idx1{0,1,3,3,3}, idx2{0,2,1,0,3},ptr1{0,2,3,4,5},ptr2{0,2,3,4,5};
//     matrix<double> mat1(ptr1,idx1,val1,4), mat2{ptr2,idx2,val2,4};
//     matrix<double>matprod=mat1.mult(mat2);
//     matrix<double>matsum=mat1.plus(mat2);
//     mat1.transpose();
}

    }
    
    
}}
