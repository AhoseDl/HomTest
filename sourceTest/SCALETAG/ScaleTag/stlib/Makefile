TARGET        = libstlib.so.1.0.0
TARGETA       = ../binaries/linux/icc/x64/debug/libstlib.a
TARGET0       = libstlib.so
TARGETD       = libstlib.so.1.0.0
TARGET1       = libstlib.so.1
TARGET2       = libstlib.so.1.0


first: all
####### Build rules

../binaries/linux/icc/x64/debug/libstlib.so.1.0.0:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d ../binaries/linux/icc/x64/debug/ || mkdir -p ../binaries/linux/icc/x64/debug/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../binaries/linux/icc/x64/debug/$(TARGET)
	-$(MOVE) $(TARGET) ../binaries/linux/icc/x64/debug/$(TARGET)
	-$(DEL_FILE) ../binaries/linux/icc/x64/debug/$(TARGET0)
	-$(DEL_FILE) ../binaries/linux/icc/x64/debug/$(TARGET1)
	-$(DEL_FILE) ../binaries/linux/icc/x64/debug/$(TARGET2)
	-$(MOVE) $(TARGET0) ../binaries/linux/icc/x64/debug/$(TARGET0)
	-$(MOVE) $(TARGET1) ../binaries/linux/icc/x64/debug/$(TARGET1)
	-$(MOVE) $(TARGET2) ../binaries/linux/icc/x64/debug/$(TARGET2)



staticlib: ../binaries/linux/icc/x64/debug/libstlib.a

../binaries/linux/icc/x64/debug/libstlib.a:  $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)

