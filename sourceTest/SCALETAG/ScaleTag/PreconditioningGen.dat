PC pc;
Mat K; // Votre matrice 1/2 * Xt.K.X
Vec b, y; // Vecteurs d'entrée et de sortie

// 1. Création et liaison
PCCreate(PETSC_COMM_WORLD, &pc);
PCSetOperators(pc, K, K);

// 2. Définition du type ICC
PCSetType(pc, PCICC);

// 3. Réglages optionnels (ex: ICC(k) avec k=1)
PCFactorSetLevels(pc, 1); 
// Optionnel: Gérer les pivots nuls/négatifs
PCFactorSetShiftType(pc, MAT_SHIFT_POSITIVE_DEFINITE);

// 4. Calcul effectif de la factorisation incomplet
PCSetUp(pc);

// 5. Application manuelle : y = M^-1 * b
PCApply(pc, b, y);

// Nettoyage
PCDestroy(&pc);


//////////////////////////////////////////////////
################ subsolver setting with petscSolve2 ###############

    TaoALMMGetSubsolver(tao, &subsolver);
    TaoSetType(subsolver, TAOBQNKTR);//TAOBQNKTR(default) TAOBNCG TAOBQNLS
    TaoSetTolerances(subsolver, /*1.e-4*/0.038, 0.0, 0.0);
    //TaoSetMaximumFunctionEvaluations(subsolver, PETSC_UNLIMITED);
    KSP subksp;
    TaoGetKSP(subsolver, &subksp);
    KSPSetType(subksp, KSPPREONLY);
    KSPSetTolerances(subksp, 1e-8, PETSC_DEFAULT, PETSC_DEFAULT, 200);
    PC subpc;
    KSPGetPC(subksp, &subpc);
    PCSetType(subpc, PCLU);

    TaoSetMaximumFunctionEvaluations(subsolver, 200);
    TaoSetUp(subsolver);
